# ــــــــ إعدادات موقع فالوري ــــــــ
# انسخ هذا الملف إلى .env.local واملأ القيم. المتغيّرات التي تبدأ بـ
# NEXT_PUBLIC_ تصل إلى المتصفّح، فلا تضع فيها أسرارًا.

# عنوان الموقع المنشور — بلا شرطة مائلة في آخره.
# منه تُبنى روابط canonical وOpen Graph وsitemap.xml وrobots.txt.
# في التطوير يكفي تركه فارغًا (يسقط إلى http://localhost:3000).
NEXT_PUBLIC_SITE_URL=https://example.com

# نطاق التحليلات عبر Plausible (اختياري، خصوصيّ بلا كوكيز).
# اتركه فارغًا فلا يُحمَّل أيُّ سكربت تتبّع. مثال: valory-parfumes.com
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# ــــــــ ملاحظة عن الواتساب وأرقام الفروع ــــــــ
# أرقام الواتساب والهواتف تعيش في app/catalog.ts داخل مصفوفة BRANCHES،
# لا في متغيّرات البيئة — لأن لكلِّ فرعٍ رقمَه، والكتالوجُ مصدرُ الحقيقة.
# لإضافة رقم فرعٍ أو تعديله، حرّر BRANCHES هناك.

# ــــــــ أدوات الإدارة ــــــــ
# لوحة /admin/prices وواجهاتُ الكتابة (/api/prices و/api/product-image)
# تعمل في وضع التطوير وحده (NODE_ENV=development). في الإنتاج تُعيد 404
# تلقائيًّا فلا يبلغها زائرٌ ولا يعدّل الأسعار أحد. لا يلزمها متغيّر بيئة.
